<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SqlSmartCompleteSetup</AssemblyName>
    <RootNamespace>SqlSmartCompleteSetup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SQL Smart Complete Setup</Product>
    <Company>EMSL</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ExtensionOutput>..\SqlSmartComplete.Ssms\bin\$(Configuration)\net472</ExtensionOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the extension first; its output is embedded into the setup. -->
    <ProjectReference Include="..\SqlSmartComplete.Ssms\SqlSmartComplete.Ssms.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ExtensionOutput)\SqlSmartComplete.dll" LogicalName="payload.SqlSmartComplete.dll" />
    <EmbeddedResource Include="$(ExtensionOutput)\extension.vsixmanifest" LogicalName="payload.extension.vsixmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
