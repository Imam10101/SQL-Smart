<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SqlSmartComplete</AssemblyName>
    <RootNamespace>SqlSmartComplete.Ssms</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SQL Smart Complete</Product>
    <Company>EMSL</Company>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Path to the SSMS IDE folder; override with /p:SsmsIde=... -->
    <SsmsIde Condition="'$(SsmsIde)' == ''">C:\Program Files\Microsoft SQL Server Management Studio 22\Release\Common7\IDE</SsmsIde>
    <SsmsEditor>$(SsmsIde)\CommonExtensions\Microsoft\Editor</SsmsEditor>
    <SsmsPublic>$(SsmsIde)\PublicAssemblies</SsmsPublic>
  </PropertyGroup>

  <!-- The engine is compiled into this assembly so the extension ships as a single DLL. -->
  <ItemGroup>
    <Compile Include="..\SqlSmartComplete.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="netstandard" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.Language"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Language.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Language.Intellisense"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Language.Intellisense.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Text.Data"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Text.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Text.Logic"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Text.Logic.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Text.UI"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Text.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Text.UI.Wpf"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.Text.UI.Wpf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.CoreUtility"><HintPath>$(SsmsEditor)\Microsoft.VisualStudio.CoreUtility.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.ImageCatalog"><HintPath>$(SsmsIde)\Microsoft.VisualStudio.ImageCatalog.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.15.0"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.Shell.15.0.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.Shell.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Interop"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.Interop.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Interop"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.Shell.Interop.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.OLE.Interop"><HintPath>$(SsmsPublic)\Microsoft.VisualStudio.OLE.Interop.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>$(SsmsPublic)\System.Collections.Immutable.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Memory"><HintPath>$(SsmsPublic)\System.Memory.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
